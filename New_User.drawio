        <mxCell id="rwiGH5wXDKDpxSEQA8MS-1" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Employee View&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="-860" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rwiGH5wXDKDpxSEQA8MS-2" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Employee View&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;" vertex="1" parent="1">
          <mxGeometry x="240" y="-710" width="915" height="480" as="geometry" />
        </mxCell>
        <mxCell id="rwiGH5wXDKDpxSEQA8MS-3" value="&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can see the current week schedule. &lt;br&gt;(e.g. Teams app - weekly schedule, we can enable the history to see past weeks)&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can add extra availability for current week &lt;br&gt;(user can add extra availability from the first day of the current week)&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can pick up available shifts apart from assigned shifts&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can see when employee showed up to work and when not (schedule grid with red and green color)&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can swap their shift with others (other employee &amp;amp; management approval required)&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can do sick call&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can book vacation (management needs to approve it)&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;can update availability&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;(management needs to approve it)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="rwiGH5wXDKDpxSEQA8MS-2">
          <mxGeometry x="20" y="50" width="850" height="400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
